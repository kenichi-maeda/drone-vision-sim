# Per-run workbench settings, read by recipe/launchers/default.sh at start.
# Restart the workbench to apply a change.

# The camera page chooses the object at flight time. This default is the duckie.
# 11 = stop sign, 32 = sports ball (the yellow duckie), 7 = truck (a colored bot).
YOLO_TARGET_CLASS_ID=32
YOLO_ALLOWED_CLASS_IDS=7,11,32
YOLO_CONFIDENCE_THRESHOLD=0.05

# Live camera view with YOLO boxes (see README, "Watch the camera live").
CAMERA_VIEWER=true

# Matrix keyboard input used by the drive view.
MATRIX_DATA_IN=ws://172.17.0.1:7505
