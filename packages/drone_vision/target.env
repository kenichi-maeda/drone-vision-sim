# Per-run workbench settings, read by recipe/launchers/default.sh at start.
# Restart the workbench to apply a change.

# Flight still chases the duckie. The camera draws every allowed class.
# 11 = stop sign, 32 = sports ball (the yellow duckie).
# A blue duckiebot is also in the map. YOLOv8n's truck score on it stays
# under the confidence floor, so it is not a required class.
YOLO_TARGET_CLASS_ID=32
YOLO_ALLOWED_CLASS_IDS=11,32
YOLO_CONFIDENCE_THRESHOLD=0.08

# Live camera view with YOLO boxes (see README, "Watch the camera live").
CAMERA_VIEWER=true

# Matrix keyboard input used by the drive view.
MATRIX_DATA_IN=ws://172.17.0.1:7505
