# Per-run workbench settings, read by recipe/launchers/default.sh at start.
# Restart the workbench to apply a change.

# Target for the YOLO detector.
# 11 = COCO stop sign. 32 = COCO sports ball (how YOLO labels the duckie).
# Use YOLO_TARGET_CLASS_ID=-1 with YOLO_ALLOWED_CLASS_IDS=11,32 for "either".
YOLO_TARGET_CLASS_ID=32

# Live camera view with YOLO boxes (see README, "Watch the camera live").
CAMERA_VIEWER=true
