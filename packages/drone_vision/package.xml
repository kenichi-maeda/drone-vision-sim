<?xml version="1.0"?>
<package format="3">
  <name>drone_vision</name>
  <version>0.0.1</version>
  <description>Read-only visual perception nodes for the Duckiedrone simulator.</description>
  <maintainer email="user@example.invalid">Drone Vision Project</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
